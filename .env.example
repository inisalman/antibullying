# Admin access. Generate a unique password (12+ chars) and secret (32+ chars).
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-of-32-characters

# Required for deployment. Use the service role key on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: local development data directory. Defaults to ./data.
# LOCAL_DATA_DIR=
